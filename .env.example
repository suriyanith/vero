# Copy to .env and fill in. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vero:vero@localhost:5432/vero

# Free key from Google AI Studio. Do not enable billing on its project.
GEMINI_API_KEY=
# A current Gemini Flash model ID from AI Studio
GEMINI_MODEL=
VERO_LLM_MODE=fake
VERO_LLM_MAX_RPM=10
VERO_LLM_TIMEOUT_SECONDS=60
VERO_LLM_MAX_OUTPUT_TOKENS=8192

VERO_RETRIEVAL_TOP_K=10
VERO_MAX_NOTE_CHARS=20000
VERO_MAX_BATCH_FILES=25

VERO_SEED_CODER_PASSWORD=
VERO_SEED_ADMIN_PASSWORD=

LOG_LEVEL=INFO
